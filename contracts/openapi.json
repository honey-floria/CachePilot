{
  "openapi": "3.1.0",
  "info": {
    "title": "CachePilot API",
    "version": "0.1.0",
    "description": "严格的初始 API 契约。仅支持本文档中明确描述的功能。"
  },
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "operationId": "createChatCompletion",
        "summary": "创建纯文本流式聊天补全",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Priority"
          },
          {
            "$ref": "#/components/parameters/DeadlineMs"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "minimal": {
                  "value": {
                    "model": "Qwen/Qwen2.5-0.5B-Instruct",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Hello"
                      }
                    ],
                    "stream": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE 流。正常结束块或错误事件之后均会发送 data: [DONE]。",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-cache"
                }
              }
            },
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "x-sse-contract": {
              "dataSchema": {
                "$ref": "#/components/schemas/ChatCompletionChunk"
              },
              "errorEventSchema": {
                "$ref": "#/components/schemas/ErrorResponse"
              },
              "normalTermination": [
                "包含 finish_reason（stop 或 length）和 usage 的终止 JSON 块",
                "data: [DONE]"
              ],
              "errorTermination": [
                "携带 ErrorResponse 数据的 event: error 事件",
                "data: [DONE]"
              ]
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "504": {
            "$ref": "#/components/responses/DeadlineExceeded"
          }
        }
      }
    },
    "/v1/requests/{request_id}": {
      "get": {
        "operationId": "getRequest",
        "summary": "获取同一租户的请求状态",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestIdPath"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "responses": {
          "200": {
            "description": "当前请求状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestStatus"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/requests/{request_id}/cancel": {
      "post": {
        "operationId": "cancelRequest",
        "summary": "取消同一租户的请求",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestIdPath"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "responses": {
          "200": {
            "description": "该请求已被取消",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancellationResponse"
                }
              }
            }
          },
          "202": {
            "description": "取消操作在终态竞争中胜出并已被接受",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancellationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "TenantId": {
        "name": "X-Tenant-ID",
        "in": "header",
        "required": true,
        "description": "初始 API 中唯一的租户身份来源。",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        }
      },
      "RequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "description": "可选的全局唯一请求 ID；省略时由服务器生成。",
        "schema": {
          "$ref": "#/components/schemas/RequestId"
        }
      },
      "Priority": {
        "name": "X-Priority",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "interactive",
            "batch"
          ],
          "default": "interactive"
        }
      },
      "DeadlineMs": {
        "name": "X-Deadline-Ms",
        "in": "header",
        "required": false,
        "description": "请求的总相对时间预算，单位为毫秒，使用服务器单调时钟计量。",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "按租户、请求方法和路径限定作用域的去重键。",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "RequestIdPath": {
        "name": "request_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/RequestId"
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "CachePilot 使用的规范请求 ID。",
        "schema": {
          "$ref": "#/components/schemas/RequestId"
        }
      },
      "RetryAfter": {
        "description": "重试延迟，单位为整数秒；仅在建议重试时提供。",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求违反固定契约。",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "模型或租户作用域内的请求不存在。",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "请求 ID、幂等性或终态冲突。",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "请求因租户配额、队列或准入限制而被拒绝。",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unavailable": {
        "description": "当前没有可用的健康服务或工作进程容量。",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "DeadlineExceeded": {
        "description": "在 SSE 响应开始之前，请求已超过截止时间。",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "RequestId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "ChatMessage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "description": "仅支持文本。内容片段数组和多模态输入将被拒绝。"
          }
        }
      },
      "ChatCompletionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "messages",
          "stream"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "const": "Qwen/Qwen2.5-0.5B-Instruct",
            "description": "初始部署固定使用的唯一模型。"
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "stream": {
            "type": "boolean",
            "const": true
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096,
            "default": 256
          }
        }
      },
      "Usage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens"
        ],
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "completion_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ChatCompletionChunk": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "object",
          "model",
          "choices"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "object": {
            "type": "string",
            "const": "chat.completion.chunk"
          },
          "model": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "delta",
                "finish_reason"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "const": 0
                },
                "delta": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "role": {
                      "type": "string",
                      "const": "assistant"
                    },
                    "content": {
                      "type": "string"
                    }
                  }
                },
                "finish_reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "stop",
                    "length",
                    null
                  ]
                }
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "code",
          "message",
          "param",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "param": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "RequestStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "state"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "state": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "TOKENIZED",
              "QUEUED",
              "ADMITTED",
              "ROUTED",
              "EXECUTING",
              "FINISHED",
              "CANCELLED",
              "TIMED_OUT",
              "REJECTED",
              "FAILED"
            ]
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "CancellationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "state"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "state": {
            "type": "string",
            "const": "CANCELLED"
          }
        }
      }
    }
  }
}
