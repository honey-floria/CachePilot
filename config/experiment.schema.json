{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cachepilot.local/schema/experiment-v1.json",
  "title": "CachePilot experiment protocol schemas",
  "description": "Machine-readable schemas for deterministic workload replay and experiment artifacts.",
  "oneOf": [
    {"$ref": "#/$defs/TraceRecord"},
    {"$ref": "#/$defs/Manifest"},
    {"$ref": "#/$defs/RequestRecord"},
    {"$ref": "#/$defs/Summary"}
  ],
  "$defs": {
    "TraceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_version",
        "request_id",
        "tenant_id",
        "arrival_ms",
        "prompt_tokens",
        "expected_output_tokens",
        "seed"
      ],
      "properties": {
        "trace_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "arrival_ms": {"type": "integer", "minimum": 0},
        "priority": {"enum": ["interactive", "batch"]},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "expected_output_tokens": {"type": "integer", "minimum": 0},
        "max_new_tokens": {"type": "integer", "minimum": 1},
        "prefix_group": {"type": ["string", "null"]},
        "cancel_after_ms": {"type": ["integer", "null"], "minimum": 0},
        "seed": {"type": "integer", "minimum": 0}
      }
    },
    "Clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_clock", "duration_unit", "arrival_origin", "wall_clock_role"],
      "properties": {
        "event_clock": {"const": "monotonic_ns"},
        "duration_unit": {"const": "ms"},
        "arrival_origin": {"const": "trace_zero"},
        "wall_clock_role": {"const": "metadata_only"}
      }
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "run_id",
        "trace_id",
        "created_at_utc",
        "clock",
        "seed",
        "repetition_index",
        "warmup",
        "hardware",
        "software",
        "model",
        "strategy"
      ],
      "properties": {
        "artifact_type": {"const": "cachepilot_experiment_manifest"},
        "schema_version": {"const": 1},
        "run_id": {"type": "string", "minLength": 1},
        "trace_id": {"type": "string", "minLength": 1},
        "created_at_utc": {"type": "string", "minLength": 1},
        "clock": {"$ref": "#/$defs/Clock"},
        "seed": {"type": "integer", "minimum": 0},
        "repetition_index": {"type": "integer", "minimum": 0},
        "warmup": {"type": "boolean"},
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "platform", "cpu", "gpu", "gpu_count", "gpu_memory_bytes", "driver", "cuda", "topology"],
          "properties": {
            "host": {"type": "string", "minLength": 1},
            "platform": {"type": "string", "minLength": 1},
            "cpu": {"type": "string", "minLength": 1},
            "gpu": {"type": "string", "minLength": 1},
            "gpu_count": {"type": "integer", "minimum": 0},
            "gpu_memory_bytes": {"type": "integer", "minimum": 0},
            "driver": {"type": "string", "minLength": 1},
            "cuda": {"type": "string", "minLength": 1},
            "topology": {"type": "string", "minLength": 1}
          }
        },
        "software": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cachepilot", "python", "os", "executor", "torch", "transformers", "vllm", "git_commit"],
          "properties": {
            "cachepilot": {"type": "string", "minLength": 1},
            "python": {"type": "string", "minLength": 1},
            "os": {"type": "string", "minLength": 1},
            "executor": {"type": "string", "minLength": 1},
            "torch": {"type": "string", "minLength": 1},
            "transformers": {"type": "string", "minLength": 1},
            "vllm": {"type": "string", "minLength": 1},
            "git_commit": {"type": "string", "minLength": 1}
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision", "tokenizer_revision", "dtype", "quantization", "context_limit"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "tokenizer_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "dtype": {"type": "string", "minLength": 1},
            "quantization": {"type": "string", "minLength": 1},
            "context_limit": {"type": "integer", "minimum": 1}
          }
        },
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "executor", "admission", "scheduler", "router", "prefix_mode"],
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "executor": {"type": "string", "minLength": 1},
            "admission": {"type": "string", "minLength": 1},
            "scheduler": {"type": "string", "minLength": 1},
            "router": {"type": "string", "minLength": 1},
            "prefix_mode": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "RequestRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "run_id",
        "request_id",
        "tenant_id",
        "seed",
        "arrival_ms",
        "prompt_tokens",
        "expected_output_tokens",
        "completion_tokens",
        "terminal_state",
        "queue_ms",
        "ttft_ms",
        "tpot_ms",
        "total_ms",
        "worker_id",
        "logical_hit",
        "physical_hit",
        "reserved_blocks_peak",
        "estimated_gpu_seconds"
      ],
      "properties": {
        "record_type": {"const": "request"},
        "schema_version": {"const": 1},
        "run_id": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "arrival_ms": {"type": "number", "minimum": 0},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "expected_output_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "terminal_state": {"enum": ["FINISHED", "CANCELLED", "TIMED_OUT", "REJECTED", "FAILED"]},
        "queue_ms": {"type": ["number", "null"], "minimum": 0},
        "ttft_ms": {"type": ["number", "null"], "minimum": 0},
        "tpot_ms": {"type": ["number", "null"], "minimum": 0},
        "total_ms": {"type": ["number", "null"], "minimum": 0},
        "worker_id": {"type": ["string", "null"]},
        "logical_hit": {"type": "boolean"},
        "physical_hit": {"type": ["boolean", "null"]},
        "reserved_blocks_peak": {"type": ["number", "null"], "minimum": 0},
        "estimated_gpu_seconds": {"type": ["number", "null"], "minimum": 0},
        "admission_reason": {"type": ["string", "null"], "minLength": 1},
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["phase", "start_ms", "end_ms"],
            "properties": {
              "phase": {"type": "string", "minLength": 1},
              "start_ms": {"type": "number", "minimum": 0},
              "end_ms": {"type": "number", "minimum": 0}
            },
            "additionalProperties": true
          }
        }
      }
    },
    "Metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "p50", "p95", "p99"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "p50": {"type": ["number", "null"], "minimum": 0},
        "p95": {"type": ["number", "null"], "minimum": 0},
        "p99": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "run_id",
        "trace_id",
        "seed",
        "repetition_index",
        "warmup",
        "request_count",
        "measured_request_count",
        "terminal_counts",
        "metrics",
        "throughput_completion_tokens_per_s",
        "rejection_rate",
        "cancellation_rate",
        "fairness_jain",
        "quantile_method",
        "source"
      ],
      "properties": {
        "artifact_type": {"const": "cachepilot_experiment_summary"},
        "schema_version": {"const": 1},
        "run_id": {"type": "string", "minLength": 1},
        "trace_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "repetition_index": {"type": "integer", "minimum": 0},
        "warmup": {"type": "boolean"},
        "request_count": {"type": "integer", "minimum": 0},
        "measured_request_count": {"type": "integer", "minimum": 0},
        "terminal_counts": {"type": "object"},
        "metrics": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/Metric"}
        },
        "throughput_completion_tokens_per_s": {"type": ["number", "null"], "minimum": 0},
        "rejection_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "cancellation_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "fairness_jain": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "quantile_method": {"const": "nearest_rank"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest", "requests"],
          "properties": {
            "manifest": {"type": "string", "minLength": 1},
            "requests": {"type": "string", "minLength": 1},
            "trace": {"type": "string", "minLength": 1}
          }
        },
        "request_timelines": {
          "type": "array",
          "items": {"type": "object"}
        },
        "admission_reasons": {"type": "object"},
        "resource_peaks": {"type": "object"},
        "simulation": {"type": "object"},
        "control_variables": {"type": "object"}
      }
      }
    }
  }
